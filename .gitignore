# Build output and ISO artifacts are never committed.
output/
artifacts/
*.iso
*.ISO
*.tar
*.tar.gz
*.tgz
*.tar.xz
*.zip

# Vendor-owned Konica Minolta runtime data: never commit.
# For a local build, drop your licensed 245igdi files into vendor-data/ before
# building; the Containerfile reads them into the image, but git never will.
vendor/
vendor-data/
*.icm
*.hft

# Proprietary Microsoft/Office fonts: never commit.
# For a local build, copy your licensed .ttf/.ttc files into fonts/ before
# building; the Containerfile reads them into the image, but git never will.
fonts/

.DS_Store
